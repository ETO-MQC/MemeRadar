# ===== 默认安全模式 =====
# 不填任何密钥也可以运行：热点雷达 + Gate公开行情 + 模拟盘。

# ----- LLM（可选）-----
# 兼容 OpenAI API 的本地/云端服务。你的 llama.cpp 可直接使用类似：
LLM_BASE_URL=http://127.0.0.1:8092/v1
LLM_API_KEY=
LLM_MODEL=local-model
LLM_ENABLED=false

# ----- X 官方 API（可选，只读）-----
X_BEARER_TOKEN=

# ----- GoPlus Token Security（可选）-----
GOPLUS_TOKEN=

# ----- Gate 实盘（可选，默认永久关闭）-----
GATE_API_KEY=
GATE_API_SECRET=
LIVE_TRADING_ENABLED=false
# 即使上面改 true，也必须同时填写下行固定确认词才允许下真实订单：
LIVE_ARM_CODE=
