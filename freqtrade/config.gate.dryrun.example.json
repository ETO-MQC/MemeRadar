{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 2,
  "tradable_balance_ratio": 0.95,
  "dry_run": true,
  "dry_run_wallet": 50,
  "timeframe": "1m",
  "exchange": {
    "name": "gate",
    "key": "",
    "secret": "",
    "ccxt_config": {"enableRateLimit": true},
    "pair_whitelist": ["DOGE/USDT", "PEPE/USDT"],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "entry_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "same", "use_order_book": true, "order_book_top": 1},
  "api_server": {"enabled": true, "listen_ip_address": "127.0.0.1", "listen_port": 8080, "username": "local", "password": "change-me"},
  "bot_name": "MemeRadar-Freqtrade",
  "initial_state": "running"
}
